.env
.env.local
.env.*.local

# ============ OS / IDE ============
.DS_Store
.idea/
.vscode/
*.iml
*.iws

# ============ Logs ============
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ Test coverage ============
coverage/
*.lcov

# ============ Misc ============
.metadata
*.swp
*.tmp
.env.tmp
