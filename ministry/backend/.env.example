PORT=3000
# Add your online PostgreSQL URL (Neon/Supabase/RDS). Example:
# DATABASE_URL=postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Human dashboard auth tokens (Bearer)
AUTH_ADMIN_TOKEN=dev-admin-token
AUTH_INSPECTOR_TOKEN=dev-inspector-token
AUTH_ANALYST_TOKEN=dev-analyst-token

# Device/POS sync credentials (X-Sync-Key)
DEVICE_SYNC_API_KEY=local-dev-sync-key
POS_SYNC_API_KEY=local-dev-sync-key
SYNC_API_KEY=local-dev-sync-key

# Optional alternatives understood by backend:
# POSTGRES_URL=
# POSTGRES_URI=
# PGSSL=true
